---
// TA, Taylor's teaching assistant.
// Works in layers, so it's never broken:
//   1. No JavaScript: greeting + track links.
//   2. AI off (TA_ENDPOINT empty): the question box answers honestly and offers
//      to send the question to Taylor by email.
//   3. AI on (TA_ENDPOINT set): questions go to the TA Worker. (Wired up in the
//      chat step; until then this layer is skipped.)
const base = import.meta.env.BASE_URL;
const TA_ENDPOINT = ''; // e.g. https://ta-worker.<subdomain>.workers.dev once deployed
const CONTACT_EMAIL = 'hello@taylortrujillo.me';

const tracks = [
  { label: 'Learning & enablement', href: `${base}for/enablement/`, primary: true },
  { label: 'Content strategy', href: `${base}for/content/` },
  { label: 'AI enablement', href: `${base}for/ai/` },
];
---
<aside class="ta-panel" aria-label="TA, Taylor's teaching assistant" data-endpoint={TA_ENDPOINT} data-email={CONTACT_EMAIL}>
  <div class="ta-panel-bar">
    <span class="ta-name">TA</span>
    <span class="ta-role">Taylor's teaching assistant · AI</span>
  </div>
  <div class="ta-panel-body">
    <!-- Replace with the TA sprite when the pixel art is ready. -->
    <div class="ta-sprite" aria-hidden="true"><span>TA</span></div>
    <p class="ta-greeting">Hi! I'm TA. What are you hiring for? I'll pull the right files.</p>
  </div>
  <nav class="ta-chips" aria-label="Choose a hiring track">
    {tracks.map((t) => (
      <a href={t.href} class:list={['ta-chip', { 'ta-chip--primary': t.primary }]}>{t.label}</a>
    ))}
  </nav>
  <form class="ta-ask" novalidate>
    <label for="ta-question">Or ask a question</label>
    <div class="ta-ask-row">
      <input id="ta-question" name="question" type="text" maxlength="500" autocomplete="off" placeholder="e.g. How does Taylor measure learning?" />
      <button type="submit">Ask</button>
    </div>
  </form>
  <div class="ta-reply" aria-live="polite" hidden></div>
  <a class="ta-all" href="#featured-projects">Or browse everything <span aria-hidden="true">↓</span></a>
</aside>

<script>
  // Builds TA's reply out of DOM nodes (never innerHTML), so a visitor's
  // question can't inject markup.
  function reply(panel: HTMLElement, question: string) {
    const box = panel.querySelector<HTMLElement>('.ta-reply')!;
    const email = panel.dataset.email!;
    box.replaceChildren();

    const asked = document.createElement('p');
    asked.className = 'ta-reply-question';
    asked.textContent = `“${question}”`;

    const answer = document.createElement('p');
    answer.textContent =
      "Good question. I'm still learning to answer those on my own, so it's not in my lesson plans yet. Want to send it straight to Taylor?";

    const link = document.createElement('a');
    link.className = 'ta-chip ta-chip--primary';
    link.href = `mailto:${email}?subject=${encodeURIComponent('Question from your portfolio')}&body=${encodeURIComponent(question)}`;
    link.textContent = 'Email Taylor this question';

    box.append(asked, answer, link);
    box.hidden = false;
  }

  document.querySelectorAll<HTMLElement>('.ta-panel').forEach((panel) => {
    const form = panel.querySelector<HTMLFormElement>('.ta-ask');
    const input = panel.querySelector<HTMLInputElement>('#ta-question');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const question = input?.value.trim() ?? '';
      if (!question) {
        input?.focus();
        return;
      }
      // The AI layer (panel.dataset.endpoint) plugs in here in the chat step.
      reply(panel, question);
    });
  });
</script>
