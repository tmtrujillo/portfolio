---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApproachItem from '../components/ApproachItem.astro';
import ProjectCard from '../components/ProjectCard.astro';

const base = import.meta.env.BASE_URL;

// Lucide-style SVG icons (stroke-based, 24x24 viewBox)
const icons = {
  // Approach
  mortarboard: `<svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.1 2.7 3 6 3s6-1.9 6-3v-5"/></svg>`,
  barChart: `<svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  layers: `<svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  // Featured
  cpu: `<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>`,
  calendar: `<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  layout: `<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
  // Earlier work
  messageCircle: `<svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  penTool: `<svg viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
  fileText: `<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
};
---
<BaseLayout title="Taylor Trujillo — Product Education & Curriculum Design">
  <section class="hero">
    <div class="container">
      <div class="hero-content fade-in">
        <span class="hero-label">Product Education · Curriculum Design</span>
        <h1>Taylor Trujillo</h1>
        <p class="tagline">
          I design the content and knowledge systems that help customers learn and succeed
          with complex products — from Academy courses and video tutorials to AI-assisted
          content pipelines that scale education without scaling headcount.
        </p>
      </div>
    </div>
  </section>

  <section class="approach-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">What I Bring</span>
      </div>
      <div class="approach-grid fade-in">
        <ApproachItem
          icon={icons.mortarboard}
          heading="Teaching background"
          description="5 years in the classroom before tech. I design learning experiences with instructional rigor — not just content that exists, but content that teaches."
        />
        <ApproachItem
          icon={icons.barChart}
          heading="Measurement-first"
          description="Every program I ship includes a scorecard. I tie education to product adoption, not just views and completions."
        />
        <ApproachItem
          icon={icons.layers}
          heading="Systems that scale"
          description="AI pipelines, contributor guidelines, deterministic lint checks. I build infrastructure so a small team can maintain a growing content library."
        />
      </div>
    </div>
  </section>

  <section id="featured-projects" class="projects-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Featured Projects</span>
        <h2 class="section-title">Recent work</h2>
      </div>
      <div class="projects-grid">
        <div class="fade-in stagger-1">
          <ProjectCard
            icon={icons.cpu}
            title="AI content pipelines"
            description="Governed AI workflows for course and guide production — 117+ runs, installed and used by teammates."
            href={`${base}projects/ai-content-pipelines/`}
          />
        </div>
        <div class="fade-in stagger-2">
          <ProjectCard
            icon={icons.calendar}
            title="Giving season education program"
            description="5 courses, cross-channel strategy, and a pilot scorecard tying education to feature adoption."
            href={`${base}projects/giving-season/`}
          />
        </div>
        <div class="fade-in stagger-3">
          <ProjectCard
            icon={icons.layout}
            title="Academy redesign and video"
            description="Use-case-first IA, custom front-end components, and a scalable video production system."
            href={`${base}projects/academy-redesign/`}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="projects-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Earlier Work</span>
        <h2 class="section-title">Foundation projects</h2>
      </div>
      <div class="projects-grid">
        <div class="fade-in stagger-1">
          <ProjectCard
            icon={icons.messageCircle}
            title="In-app education"
            description="Centralized resource center that cut support cases by 45% YoY and engaged 1,000+ admins per month."
            href={`${base}projects/resource-center/`}
          />
        </div>
        <div class="fade-in stagger-2">
          <ProjectCard
            icon={icons.penTool}
            title="Microcopy"
            description="Product copy revisions for accessibility, clarity, and style guide alignment on Classy Studio."
            href={`${base}projects/microcopy/`}
          />
        </div>
        <div class="fade-in stagger-3">
          <ProjectCard
            icon={icons.fileText}
            title="Documentation"
            description="Docs-as-code help center for beta features, adopted across the entire release process."
            href={`${base}projects/early-access-help-center/`}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
