---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApproachItem from '../components/ApproachItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { icons } from '../components/icons';

const base = import.meta.env.BASE_URL;

---
<BaseLayout title="Taylor Trujillo — Product Education & Curriculum Design">
  <section class="hero">
    <div class="container">
      <div class="hero-content fade-in">
        <span class="hero-label">Product Education · Curriculum Design</span>
        <h1>Taylor Trujillo</h1>
        <p class="tagline">
          I design the content and knowledge systems that help customers learn and succeed
          with complex products — from Academy courses and video tutorials to AI-assisted
          content pipelines that scale education without scaling headcount.
        </p>
      </div>
    </div>
  </section>

  <section class="approach-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">What I Bring</span>
      </div>
      <div class="approach-grid fade-in">
        <ApproachItem
          icon={icons.mortarboard}
          heading="Teaching background"
          description="5 years in the classroom before tech. I design learning experiences with instructional rigor — not just content that exists, but content that teaches."
        />
        <ApproachItem
          icon={icons.barChart}
          heading="Measurement-first"
          description="I measure whether people act after they learn — activation, adoption, and time to value — not just views and completions."
        />
        <ApproachItem
          icon={icons.layers}
          heading="Systems that scale"
          description="AI pipelines, contributor guidelines, deterministic lint checks. I build infrastructure so a small team can maintain a growing content library."
        />
      </div>
    </div>
  </section>

  <section id="featured-projects" class="projects-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Featured Projects</span>
        <h2 class="section-title">Selected outcomes</h2>
      </div>
      <div class="projects-grid">
        <div class="fade-in stagger-1">
          <ProjectCard
            icon={icons.code}
            title="Embedded form activation"
            description="~2x more orgs started taking donations after in-app, video, and Academy install guidance."
            href={`${base}projects/embedded-studio-activation/`}
          />
        </div>
        <div class="fade-in stagger-2">
          <ProjectCard
            icon={icons.zap}
            title="Campaign templates pilot"
            description="A hands-on pilot with ~200 orgs cut time to an active campaign by 50%+ and got templates built."
            href={`${base}projects/campaign-templates-pilot/`}
          />
        </div>
        <div class="fade-in stagger-3">
          <ProjectCard
            icon={icons.flag}
            title="Scaled onboarding"
            description="New orgs reaching our success milestone rose from ~40% to 75%."
            href={`${base}projects/onboarding-time-to-value/`}
          />
        </div>
        <div class="fade-in stagger-1">
          <ProjectCard
            icon={icons.trendingUp}
            title="Intelligent Ask Amounts adoption"
            description="From ~20% to 75%+ of eligible campaigns in one year."
            href={`${base}projects/iaa-adoption/`}
          />
        </div>
        <div class="fade-in stagger-2">
          <ProjectCard
            icon={icons.layout}
            title="An Academy people finish"
            description="Short courses finish ~2x as often; task videos hold viewers for half or more of their runtime."
            href={`${base}projects/academy-redesign/`}
          />
        </div>
        <div class="fade-in stagger-3">
          <ProjectCard
            icon={icons.cpu}
            title="AI content pipelines"
            description="Course turnaround from 6+ weeks to 3 or fewer, with human approval at every step."
            href={`${base}projects/ai-content-pipelines/`}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="projects-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Earlier Work</span>
        <h2 class="section-title">Foundation projects</h2>
      </div>
      <div class="projects-grid">
        <div class="fade-in stagger-1">
          <ProjectCard
            icon={icons.messageCircle}
            title="In-app education"
            description="Centralized in-app resource center. Reporting-related support cases fell 45% YoY after launch; 1,000+ admins a month used it."
            href={`${base}projects/resource-center/`}
          />
        </div>
        <div class="fade-in stagger-2">
          <ProjectCard
            icon={icons.penTool}
            title="Microcopy"
            description="Product copy revisions for accessibility, clarity, and style guide alignment on Classy Studio."
            href={`${base}projects/microcopy/`}
          />
        </div>
        <div class="fade-in stagger-3">
          <ProjectCard
            icon={icons.fileText}
            title="Documentation"
            description="Docs-as-code help center for beta features, adopted across the entire release process."
            href={`${base}projects/early-access-help-center/`}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
