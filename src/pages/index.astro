---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { cardProps, getProjects } from '../lib/projects';

const base = import.meta.env.BASE_URL;
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const foundation = projects.filter((p) => !p.data.featured);
const stagger = (i: number) => `fade-in stagger-${(i % 3) + 1}`;
---
<BaseLayout title="Taylor Trujillo — Product Education & Curriculum Design" taHero>
  <section class="ta-stage" aria-label="Welcome">
    <div class="ta-stage-inner">
      <p class="ta-stage-brand"><span class="ta-stage-brand-name">Taylor Trujillo · </span>Product education &amp; curriculum design</p>
      <h1 class="ta-stage-headline">Teacher turned content designer, <span class="hl">still teaching.</span></h1>
      <a class="ta-stage-more" href="#featured-projects">See the work <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="featured-projects" class="projects-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Featured Projects</span>
        <h2 class="section-title">Selected outcomes</h2>
      </div>
      <div class="projects-grid">
        {featured.map((p, i) => (
          <div class={stagger(i)}>
            <ProjectCard {...cardProps(p, base)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="projects-section">
    <div class="container">
      <div class="section-header fade-in">
        <span class="section-label">Earlier Work</span>
        <h2 class="section-title">Foundation projects</h2>
      </div>
      <div class="tile-grid">
        {foundation.map((p, i) => (
          <a class={`project-tile ${stagger(i)}`} href={`${base}projects/${p.id}/`}>
            <span class="project-tile-title">{p.data.cardTitle ?? p.data.title}</span>
            <span class="project-tile-text">{p.data.teaser ?? p.data.summary}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
