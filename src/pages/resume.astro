---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillPills from '../components/SkillPills.astro';
---
<BaseLayout title="Resume — Taylor Trujillo">
  <section class="resume-section">
    <div class="container">
      <h1 class="fade-in">Resume</h1>

      <div class="role-block fade-in">
        <h3>Senior Content Designer — Product Education</h3>
        <span class="role-company">GoFundMe Pro</span>
        <span class="role-dates">April 2021 – Present · Seattle, WA</span>

        <h4>Curriculum development and instructional design</h4>
        <ul>
          <li>Design and produce Academy courses in Skilljar covering payment features, campaign tools, and platform migrations — shipped <strong>5 courses in a single quarter</strong> for giving season, each with defined learning objectives and completion tracking</li>
          <li>Create product education video at scale across 21+ production areas including recurring payments, donation forms, live events, and reporting</li>
          <li>Develop in-app learning experiences through Appcues, guiding users through multi-step technical workflows like embeddable form setup and campaign configuration</li>
          <li>Host live webinars on technical setup, such as installing embedded donation forms on WordPress, Squarespace, and Wix sites</li>
          <li>Managed the Academy's move off Articulate Rise to consolidate tools and cut costs</li>
        </ul>

        <h4>Learning measurement and evaluation</h4>
        <ul>
          <li>Track course effectiveness through Skilljar enrollment, completion rates, and time-to-completion data, using learner progress to identify drop-off points and iterate on course structure</li>
          <li>Raised the share of new organizations reaching our onboarding success milestone from <strong>~40% to 75%</strong> through a milestone-based Academy path, video lessons, and in-app and email touchpoints</li>
          <li>Grew Intelligent Ask Amounts adoption from <strong>~20% to 75%+</strong> of eligible campaigns in one year through education, in-app nudges, and advocating for it as the default</li>
          <li>Led in-app, video, and Academy install guidance for embedded donation forms; orgs that used it were <strong>~2x as likely</strong> to start taking donations</li>
          <li>Ran a manual campaign templates pilot with ~200 orgs that cut time to an active campaign by <strong>50%+</strong> and led Product to build templates into the platform</li>
          <li>Designed a cross-platform reporting framework unifying learning data from Skilljar, Wistia video engagement, and Appcues interaction metrics</li>
          <li>Decreased support contact rate by <strong>45%</strong> year over year through Python-based gap analysis of support cases, mapping content gaps to targeted tutorials and documentation</li>
        </ul>

        <h4>Payments and developer documentation</h4>
        <ul>
          <li>Write developer documentation for GoFundMe Pro, including the webhooks integration guide (setup, event types, testing, troubleshooting, and security), the Transactions and Supporters sections of the API docs, and payments docs for GoFundMe Pay, which runs on Stripe, working from SME interviews through review to publish</li>
          <li>Taught customers to build transaction reports using payment processing data</li>
          <li>Developed curriculum for recurring giving features, Giving Cart, and embedded donation forms, including teaching admins to install code on their own websites</li>
        </ul>

        <h4>Content systems and automation</h4>
        <ul>
          <li>Built governed AI content pipelines with human approval gates at each stage, cutting course turnaround from <strong>6+ weeks to 3 or fewer</strong> and supporting up to 4 concurrent contributors</li>
          <li>Developed an Appcues guide drafting pipeline (117+ logged runs, 121 guide drafts) that pulls requests, drafts copy in brand voice, and generates Figma mockups</li>
          <li>Synthesized 9 revision reports to identify recurring defects, then converted prose style rules into deterministic lint checks</li>
          <li>Created a campaign URL builder with QR code generation using embedded JavaScript, print-size exports, and UTM attribution tracking</li>
        </ul>

        <p class="role-dates" style="text-align: right; margin-top: 1rem;">Progression: Technical Writer I → Technical Writer II → Senior Content Designer</p>
      </div>

      <div class="role-block fade-in">
        <h3>Lead Lesson Plan Writer</h3>
        <span class="role-company">Uncommon Schools</span>
        <span class="role-dates">May 2019 – April 2021 (alongside teaching) · New York, NY</span>

        <ul>
          <li>Architected a remote learning content system for 200+ lesson plans across 50 schools, reducing teacher preparation time by <strong>50%</strong> while maintaining quality standards</li>
          <li>Developed modular instructional framework that decreased lesson creation from <strong>4 hours to 90 minutes</strong>, enabling rapid curriculum response to COVID-19</li>
          <li>Applied pedagogical principles to create multi-modal content (text, video, interactive), improving learner engagement metrics by <strong>40%</strong></li>
        </ul>

        <h3 style="margin-top: 1.5rem;">Lead History Teacher</h3>
        <span class="role-company">Ocean Hill Collegiate, Uncommon Schools</span>
        <span class="role-dates">March 2017 – April 2021 · Brooklyn, NY</span>

        <ul>
          <li>Taught 90+ students daily, using frequent assessments as the primary measure of learning and adjusting instruction from the results; <strong>85% proficiency</strong> on state assessments</li>
        </ul>
      </div>

      <div class="education-block fade-in">
        <h3>Education</h3>
        <p class="education-item"><strong>Master of Arts in Teaching</strong> — Relay Graduate School of Education, 2019</p>
        <p class="education-item"><strong>Bachelor of Arts in English and Communications</strong> — Florida State University, 2014</p>
      </div>

      <div class="role-block fade-in">
        <h3>Skills</h3>

        <div class="skills-group">
          <span class="skills-group-label">Instructional Design</span>
          <SkillPills skills={[
            'Curriculum Development',
            'Learning Objectives Design',
            'Assessment Development',
            'Learner Analytics',
            'Course Authoring (Skilljar)',
            'Multi-Modal Content'
          ]} />
        </div>

        <div class="skills-group">
          <span class="skills-group-label">Technical</span>
          <SkillPills skills={[
            'JavaScript',
            'Python',
            'HTML/CSS',
            'Markdown',
            'Git',
            'API & Webhook Documentation',
            'Payment Processing'
          ]} />
        </div>

        <div class="skills-group">
          <span class="skills-group-label">Tools</span>
          <SkillPills skills={[
            'Skilljar',
            'Appcues',
            'Figma',
            'Adobe Premiere Pro',
            'Adobe Creative Cloud',
            'Articulate Rise',
            'Wistia',
            'Looker',
            'Pendo',
            'Heap'
          ]} />
        </div>

        <div class="skills-group">
          <span class="skills-group-label">Methodologies</span>
          <SkillPills skills={[
            'Backward Design',
            'Agile',
            'Data-Driven Iteration',
            'User Journey Mapping',
            'Learner-Centered Design'
          ]} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
