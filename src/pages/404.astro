---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page Not Found — Taylor Trujillo">
  <section class="four-oh-four">
    <div class="container">
      <h1>404</h1>
      <p>This page doesn't exist — but the rest of the portfolio does.</p>
      <a href={base}>Back to Home</a>
    </div>
  </section>
</BaseLayout>
