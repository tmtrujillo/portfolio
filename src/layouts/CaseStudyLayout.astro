---
import BaseLayout from './BaseLayout.astro';
import CaseMeta from '../components/CaseMeta.astro';

interface Props {
  title: string;
  summary: string;
  tags: string[];
  role: string;
  platform: string;
  timeline: string;
  results?: { value: string; label: string }[];
}

const { title, summary, tags, role, platform, timeline, results = [] } = Astro.props;
---
<BaseLayout title={`${title} — Taylor Trujillo`}>
  <div class="case-hero">
    <div class="container">
      <div class="fade-in">
        <h1>{title}</h1>
        <p class="case-summary">{summary}</p>
        {results.length > 0 && (
          <dl class="results-strip">
            {results.map((r) => (
              <div class="result-stat">
                <dt>{r.value}</dt>
                <dd>{r.label}</dd>
              </div>
            ))}
          </dl>
        )}
        <CaseMeta tags={tags} role={role} platform={platform} timeline={timeline} />
      </div>
    </div>
  </div>
  <article class="case-content fade-in">
    <slot />
  </article>
</BaseLayout>
