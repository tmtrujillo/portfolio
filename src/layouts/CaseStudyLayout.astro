---
import BaseLayout from './BaseLayout.astro';
import CaseMeta from '../components/CaseMeta.astro';

interface Props {
  title: string;
  summary: string;
  tags: string[];
  role: string;
  platform: string;
  timeline: string;
  results?: { value: string; label: string }[];
  links?: { label: string; url: string; source: string }[];
}

const { title, summary, tags, role, platform, timeline, results = [], links = [] } = Astro.props;
---
<BaseLayout title={`${title} — Taylor Trujillo`}>
  <div class="case-hero">
    <div class="container">
      <div class="fade-in">
        <h1>{title}</h1>
        <p class="case-summary">{summary}</p>
        {results.length > 0 && (
          <dl class="results-strip">
            {results.map((r) => (
              <div class="result-stat">
                <dt>{r.value}</dt>
                <dd>{r.label}</dd>
              </div>
            ))}
          </dl>
        )}
        <CaseMeta tags={tags} role={role} platform={platform} timeline={timeline} />
        {links.length > 0 && (
          <div class="see-live">
            <span class="see-live-label">See it live</span>
            <ul>
              {links.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener">{l.label}<span class="sr-only"> (opens in a new tab)</span></a>
                  <span class="see-live-source">{l.source}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
  <article class="case-content fade-in">
    <slot />
  </article>
</BaseLayout>
